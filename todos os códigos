	scanf_s("%d" , &a);

	printf("digite o valor do lado b do triangulo: ");
	scanf_s("%d", &b);

	printf("digite o valor do lado c do triangulo: ");
	scanf_s("%d", &c);

	if (a + b > c && b + c > a && c + a > b )
	{
		if (a == b && b == c)
		{
			puts("Isso é um trinagulo equilatero");
		}
		else
		{
			if (a == b || a == c || b == c)
			{
				puts("Isso é um triangulo isosceles");
			}
			else
			{
				puts("Isso e um triangulo escaleno");
			}
		}
	}
	else
	{
		puts("Não é um triangulo");
	}
}

